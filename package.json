{
  "name": "rojdeal-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "preflight": "node scripts/preflight.cjs",
    "test:smoke": "node scripts/smoke.cjs && node scripts/pagination-smoke.cjs",
    "cf:build": "ROJDEAL_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "npm run preflight && npm run cf:build && opennextjs-cloudflare deploy"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "libphonenumber-js": "1.13.12",
    "lucide-react": "^0.475.0",
    "next": "15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.5",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.0"
  }
}
