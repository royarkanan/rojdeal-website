{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rojdeal-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {"directory": ".open-next/assets", "binding": "ASSETS"},
  "services": [{"binding": "WORKER_SELF_REFERENCE", "service": "rojdeal-web"}],
  "vars": {"NEXT_PUBLIC_SITE_URL": "https://rojdeal.app", "NEXT_PUBLIC_DATA_SOURCE": "supabase"},
  "routes": [{"pattern": "rojdeal.app", "custom_domain": true}],
  "workers_dev": false
}
